#!/usr/bin/env bats

# Renders the storage template of every Linux build and compares it with the golden file for its installer.
# Run with UPDATE_GOLDEN=1 to rewrite the golden files from the first build of each installer.

setup() {
  command -v packer >/dev/null || skip "packer is not installed"
  ROOT="$(cd "$BATS_TEST_DIRNAME/../.." >/dev/null 2>&1 && pwd)"
  DIR="$BATS_TEST_DIRNAME"
}

# Prints the installer that reads the templates of a distribution.
installer() {
  case "$1" in
  almalinux | centos | fedora | oracle | rhel | rocky) echo kickstart ;;
  debian) echo preseed ;;
  ubuntu) echo autoinstall ;;
  *) return 1 ;;
  esac
}

# Prints the storage template of every build, one per line.
templates() {
  find "$ROOT/builds/linux" -path '*/data/storage.pkrtpl.hcl' | sort
}

# Prints the distribution of a template, e.g. rhel for builds/linux/rhel/9/data/storage.pkrtpl.hcl.
distribution() {
  local path=${1#"$ROOT"/builds/linux/}
  printf '%s\n' "${path%%/*}"
}

# Renders the template of every build that uses an installer and compares it with a golden file.
check() {
  local installer=$1 vars=$2 golden="$DIR/golden/$3" template build output count=0 failed=0
  while IFS= read -r template; do
    [ "$(installer "$(distribution "$template")")" = "$installer" ] || continue
    build=${template#"$ROOT"/builds/linux/}
    build=${build%/data/*}
    # Builds that share a template file are rendered once.
    output="$BATS_TEST_TMPDIR/$(cksum <"$template" | tr ' ' '-')"
    if [ ! -f "$output" ] &&
      ! packer build -var-file="$DIR/$vars" -var "template=$template" -var "output_file=$output" "$DIR" \
        >"$output.log" 2>&1; then
      printf 'Failed to render %s:\n' "$build"
      cat "$output.log"
      return 1
    fi
    if [ "${UPDATE_GOLDEN:-}" = 1 ] && [ "$count" -eq 0 ]; then
      cp "$output" "$golden"
    fi
    count=$((count + 1))
    diff -u --label "golden/$3" --label "$build" "$golden" "$output" || failed=1
  done < <(templates)
  [ "$count" -gt 0 ] || {
    printf 'No builds use %s.\n' "$installer"
    return 1
  }
  return "$failed"
}

@test "each storage template belongs to a tested installer" {
  local template unknown=()
  while IFS= read -r template; do
    installer "$(distribution "$template")" >/dev/null || unknown+=("${template#"$ROOT"/}")
  done < <(templates)
  [ "${#unknown[@]}" -eq 0 ] || {
    printf 'No installer for: %s\n' "${unknown[@]}"
    return 1
  }
}

## Test LVM layout
###############################################################################
@test "storage with Autoinstall using LVM layout" {
  check autoinstall test-lvm.pkrvars.hcl lvm-autoinstall
}

@test "storage with Kickstart using LVM layout" {
  check kickstart test-lvm.pkrvars.hcl lvm-kickstart
}

@test "storage with Preseed using LVM layout" {
